SESSION_SECRET=replace_with_output_of_openssl_rand_-base64_32

# From Firebase console > Project settings > General > Your apps > Web app config.
# The apiKey here is not a secret — Firebase web config is safe to expose
# client-side; access is enforced by Firestore/Storage security rules, not
# by hiding this value.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# From Firebase console > Project settings > Service accounts > Generate new
# private key. These back the server-side Firestore access in src/lib/
# firestore.ts and are REAL secrets — the service account bypasses security
# rules entirely. Copy project_id / client_email / private_key out of the
# downloaded JSON; keep private_key's \n sequences escaped, on one line, and
# wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# From your Bunny Stream Video Library's API settings page. The API key is a
# real secret (authenticates write access) — server-only, never NEXT_PUBLIC_.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
